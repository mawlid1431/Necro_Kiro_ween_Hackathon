# Copy to .env.local and fill in. Never commit real values.

# Convex (written by `bunx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (dashboard.clerk.com > your app > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NECRO_BOT_CONTACT_URL=

# ── Set these in the Convex dashboard (server side), NOT here ──
# CLERK_JWT_ISSUER_DOMAIN   same value as above
# AI_PROVIDER               groq | openai | bedrock
# AI_MODEL                  e.g. openai/gpt-oss-120b (Groq)
# GROQ_API_KEY / OPENAI_API_KEY / AWS_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
