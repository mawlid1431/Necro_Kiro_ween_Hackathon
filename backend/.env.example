# Copy to backend/.env.local and fill in. Never commit real values.
# The Convex CLI only reads CONVEX_DEPLOYMENT from this file.
# Everything else must be pushed to the Convex deployment:  bun run env:push
CONVEX_DEPLOYMENT=

# ── Pushed to Convex env ──
CLERK_JWT_ISSUER_DOMAIN=
APP_URL=http://localhost:3000
NECRO_BOT_CONTACT_URL=

# AI keys (a missing key just skips that provider's rungs)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# AI chains: comma-separated provider:model-id rungs (groq: | google: | openrouter: | mock:), tried in order.
# Ghost mode answers when every rung fails. Private tasks (resurrect, ask) automatically skip
# rungs that may train on prompts (google: free tier, openrouter ...:free and openrouter/free).
# Look up current ids: console.groq.com/docs/models, ai.google.dev/gemini-api/docs/models,
# openrouter.ai/models (filter: free, structured outputs).
AI_CHAIN_SEANCE=groq:openai/gpt-oss-120b,google:gemini-flash-latest,openrouter:openrouter/free
AI_CHAIN_DOCTOR=groq:openai/gpt-oss-20b,openrouter:openrouter/free
AI_CHAIN_BRIEFING=groq:openai/gpt-oss-120b
AI_CHAIN_RESURRECT=groq:openai/gpt-oss-120b
AI_CHAIN_ASK=groq:openai/gpt-oss-120b
AI_EMBED_MODEL=google:gemini-embedding-001
# Optional budget overrides "perMinute,perDay" (defaults are 80% of free limits):
# AI_BUDGET_GROQ=24,800
# AI_BUDGET_OPENROUTER_FREE=16,40   (before the one-time $10 OpenRouter top-up)
# GOOGLE_PAID_TIER=true             (only if Gemini is on a paid tier that does not train on prompts)

# Long random values (32+ chars). Same values go in frontend/.env.local.
#   bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
MCP_SERVER_SECRET=
AGENT_SERVER_SECRET=
