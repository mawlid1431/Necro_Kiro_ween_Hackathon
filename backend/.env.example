# Copy to backend/.env.local and fill in. Never commit real values.
# The Convex CLI only reads CONVEX_DEPLOYMENT from this file.
# Everything else must be pushed to the Convex deployment:  bun run env:push
CONVEX_DEPLOYMENT=

# ── Pushed to Convex env ──
CLERK_JWT_ISSUER_DOMAIN=
APP_URL=http://localhost:3000
NECRO_BOT_CONTACT_URL=

# AI keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# AI models, written as provider:model-id (groq: | openrouter:)
# Look up current ids at console.groq.com/docs/models and openrouter.ai/models.
# Pick models that support structured outputs.
AI_SEANCE_MODEL=groq:openai/gpt-oss-120b
AI_DOCTOR_MODEL=groq:openai/gpt-oss-20b
AI_RESURRECT_MODEL=openrouter:google/gemma-4-31b-it:free
AI_FALLBACK_MODEL=openrouter:google/gemma-4-26b-a4b-it:free

# Long random values (32+ chars). Same values go in frontend/.env.local.
#   bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
MCP_SERVER_SECRET=
AGENT_SERVER_SECRET=
