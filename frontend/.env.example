# Copy to frontend/.env.local and fill in. Never commit real values.
# AI keys do NOT go here: they live in backend/.env.local and the Convex deployment.

# Convex (URLs printed by `bunx convex dev` in backend/)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (dashboard.clerk.com > your app > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (used by /api/mcp and /api/livekit/token). Same values as backend/.env.local.
MCP_SERVER_SECRET=
AGENT_SERVER_SECRET=

# LiveKit (Séance Live, optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
