# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only reference material (older project, not part of Necro; contains secrets)
/reference/
/Necro_Brand_Assets.zip

# playwright
/test-results/
/playwright-report/

# local editor/agent settings (never committed). Note: .kiro/ is NOT ignored:
# the hackathon requires the /.kiro directory in the public repo.
.claude/
.claude
CLAUDE.md
CLAUDE.local.md

# convex local state
.convex/

# Temporary local visual-check pages (never deployed)
frontend/app/zz-*/

# /brag video work: kept local only
brag-output/

# docs: private planning, drafts and brand files stay local.
# Judge-facing docs stay public (Devpost and the README link to them).
docs/*
!docs/KIRO_WRITEUP.md
!docs/KIRO_LOG.md
!docs/MCP.md
!docs/Necro_Project_Documentation.pdf
!docs/specs/
